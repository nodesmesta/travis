{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelflow.local/contracts/event-item.schema.json",
  "title": "Event Item",
  "type": "object",
  "required": [
    "id",
    "trip_id",
    "context_point_id",
    "title",
    "status",
    "source_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "trip_id": { "type": "string", "minLength": 1 },
    "context_point_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "maxLength": 5000 },
    "venue_name": { "type": "string", "maxLength": 300 },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "category": { "type": "string", "maxLength": 120 },
    "status": { "enum": ["suggested", "selected", "rejected", "expired"] },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
