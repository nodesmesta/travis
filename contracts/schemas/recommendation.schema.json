{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelflow.local/contracts/recommendation.schema.json",
  "title": "Recommendation",
  "description": "A stored recommendation produced by the mobility engine. The payload is engine output. Saving, applying, or dismissing it is a separate confirmed action.",
  "type": "object",
  "required": [
    "id",
    "trip_id",
    "recommendation_type",
    "status",
    "reason",
    "payload",
    "context_snapshot",
    "policy_version",
    "source_ids",
    "created_at",
    "expires_at",
    "freshness"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "trip_id": { "type": "string", "format": "uuid" },
    "conversation_id": { "type": ["string", "null"], "format": "uuid" },
    "context_point_id": { "type": ["string", "null"], "format": "uuid" },
    "recommendation_type": { "enum": ["route"] },
    "route_request_id": { "type": ["string", "null"], "format": "uuid" },
    "route_option_id": { "type": ["string", "null"], "format": "uuid" },
    "status": {
      "enum": ["suggested", "saved", "applied", "dismissed", "expired"]
    },
    "reason": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "context_snapshot": { "type": "object" },
    "policy_version": { "type": "string", "minLength": 1 },
    "source_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "freshness": { "enum": ["fresh", "expired"] }
  }
}
