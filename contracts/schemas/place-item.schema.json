{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelflow.local/contracts/place-item.schema.json",
  "title": "Nearby Place",
  "description": "An activity (Bright Data) or restaurant (HERE Browse) near a context point. opening_hours is present only when the source provided it. Fields the source did not state are null or unknown, never guessed.",
  "type": "object",
  "required": [
    "id",
    "trip_id",
    "context_point_id",
    "category",
    "name",
    "status",
    "source_ids",
    "retrieved_at",
    "expires_at",
    "freshness",
    "opening_hours"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "trip_id": { "type": "string", "format": "uuid" },
    "context_point_id": { "type": "string", "format": "uuid" },
    "category": { "enum": ["activity", "restaurant"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "address": { "type": ["string", "null"] },
    "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "longitude": {
      "type": ["number", "null"],
      "minimum": -180,
      "maximum": 180
    },
    "distance_meters": { "type": ["integer", "null"], "minimum": 0 },
    "official_url": { "type": ["string", "null"], "format": "uri" },
    "provider_place_id": { "type": ["string", "null"] },
    "activity_type": { "type": ["string", "null"] },
    "indoor_outdoor": {
      "enum": ["indoor", "outdoor", "both", "unknown", null]
    },
    "recommended_duration_minutes": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "weather_sensitivity": {
      "enum": ["low", "medium", "high", "unknown", null]
    },
    "booking_required": { "type": ["boolean", "null"] },
    "cuisines": { "type": "array", "items": { "type": "string" } },
    "opening_hours": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        }
      ]
    },
    "status": { "enum": ["suggested", "selected", "rejected", "expired"] },
    "source_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "minItems": 1
    },
    "evidence": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "freshness": { "enum": ["fresh", "expired"] }
  }
}
