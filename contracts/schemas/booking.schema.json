{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelflow.local/contracts/booking.schema.json",
  "title": "Booking",
  "type": "object",
  "required": [
    "id",
    "user_id",
    "trip_id",
    "booking_type",
    "source_type",
    "status",
    "currency",
    "total",
    "pricing_policy",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "trip_id": { "type": "string", "minLength": 1 },
    "booking_type": {
      "enum": ["event", "activity", "itinerary_item", "hotel", "flight"]
    },
    "source_type": {
      "enum": [
        "event_discovery_result",
        "activity",
        "agenda_item",
        "liteapi_offer"
      ]
    },
    "source_id": { "type": "string", "minLength": 1 },
    "provider_name": { "type": "string", "minLength": 1 },
    "confirmation_code": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "draft",
        "pending_payment",
        "paid",
        "confirmed",
        "cancelled",
        "expired",
        "failed",
        "refunded"
      ]
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "description": "Three uppercase ASCII letters, for example IDR."
    },
    "subtotal": { "type": "number", "minimum": 0 },
    "tax": { "type": "number", "minimum": 0 },
    "total": { "type": "number", "minimum": 0 },
    "pricing_policy": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the server price policy that produced the amounts."
    },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "cancelled_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
