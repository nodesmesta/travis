# TravelFlow production environment (app layer).
#
# Copy to deploy/.env.production, fill in the values, then `chmod 600 deploy/.env.production`.
# The real file is git-ignored and excluded from every Docker image (.dockerignore).
# This example holds no secret. Empty values are intentionally empty: there are no
# built-in defaults for secrets or URLs, and the containers refuse to start when a
# required value is missing (deploy/preflight.mjs prints which one).
#
# Format rules for Docker Compose env files: one NAME=value per line, no spaces
# around "=", and wrap a value that contains "$" or "#" in single quotes.
#
# Compose reads this file twice: for ${...} substitution in docker-compose.yml
# (run with `--env-file .env.production`) and as the environment of api and worker.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# Must be "production". Compose sets it for api and worker, and preflight rejects
# anything else. In production apps/api/src/config.ts also rejects every *_OVERRIDE
# variable (BRIGHT_DATA_ENDPOINT_OVERRIDE, HERE_BASE_URL_OVERRIDE,
# OPENWEATHER_BASE_URL_OVERRIDE). They are test hooks: do not add them here.
NODE_ENV=production
LOG_LEVEL=info

# Comma-separated variable names that must be non-empty or api/worker refuse to start.
# Recommended for a real demo so a missing provider key stops the deployment.
DEPLOY_REQUIRED_ENV=VULTR_INFERENCE_API_KEY,BRIGHT_DATA_API_KEY,BRIGHT_DATA_SERP_ZONE

# ---------------------------------------------------------------------------
# Edge: Caddy (Compose substitution only)
# ---------------------------------------------------------------------------
# Public host name. Caddy obtains a Let's Encrypt certificate for it automatically.
# DNS A/AAAA for this name must point at the VM and ports 80/443 must be reachable.
SITE_ADDRESS=
# Optional. Defaults are 80:80 and 443:443 (production). Only change for local tests.
# CADDY_HTTP_PUBLISH=80:80
# CADDY_HTTPS_PUBLISH=443:443

# ---------------------------------------------------------------------------
# Supabase connection (separate stack, see deploy/README.md)
# ---------------------------------------------------------------------------
# Docker network of the Supabase stack. api, worker, and caddy join it.
# Find it with: docker network ls
SUPABASE_DOCKER_NETWORK=
# host:port of the Supabase API gateway (Kong) on that network, used by Caddy to
# forward ONLY /auth/v1/* from the browser. Example: kong:8000
SUPABASE_AUTH_UPSTREAM=
# URL of the same gateway as seen from the api and worker containers, for example
# http://kong:8000. Server side only; the browser never uses it.
SUPABASE_URL=
# Supabase anon (public) key.
SUPABASE_ANON_KEY=
# SECRET. Backend and worker only. Never put it in NEXT_PUBLIC_* or a build arg.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web build arguments (BUILD TIME, public values only)
# ---------------------------------------------------------------------------
# These are inlined into the browser bundle when the web image is built. Changing
# one means rebuilding the web image: `docker compose build web && docker compose up -d web`.
# Same-origin layout: Caddy forwards /api/* to the API and /auth/v1/* to Supabase Auth.
NEXT_PUBLIC_API_BASE_URL=
# Public origin that serves /auth/v1 (the same https://SITE_ADDRESS value).
NEXT_PUBLIC_SUPABASE_URL=
# Same value as SUPABASE_ANON_KEY (the anon key is public by design).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Do NOT add NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN here. It shows an email and password form and
# is meant for local development and the browser test scripts only. Production sign-in is
# Google only, and the Supabase Auth server refuses password sign-in (deploy/README.md).

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Compose fixes API_HOST=0.0.0.0 and API_PORT=4000 inside the container. Do not publish them.
# Browser origins allowed to call the API, comma separated. Use https://SITE_ADDRESS.
CORS_ALLOWED_ORIGINS=
# Healthcheck path for the api container: /health (liveness) or /ready (dependency
# readiness, once the endpoint is deployed). Failing makes caddy wait and `up --wait` fail.
API_HEALTHCHECK_PATH=/health

# ---------------------------------------------------------------------------
# Image tag (Compose substitution)
# ---------------------------------------------------------------------------
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Provider secrets (backend and worker only)
# ---------------------------------------------------------------------------
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=
BRIGHT_DATA_TIMEOUT_MS=60000
HERE_API_KEY=
HERE_TIMEOUT_MS=15000
LITEAPI_API_KEY=
LITEAPI_TIMEOUT_MS=30000
OPENWEATHER_API_KEY=
OPENWEATHER_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Event discovery and assistant tuning (same meaning as .env.example)
# ---------------------------------------------------------------------------
EVENT_DISCOVERY_TTL_HOURS=6
EVENT_MAX_PAGES=4
EVENT_PAGE_MAX_CHARS=15000
EVENT_PAGE_CONCURRENCY=3
AI_EXTRACTION_TIMEOUT_MS=45000
AI_PLANNER_TIMEOUT_MS=15000
AI_SYNTHESIS_TIMEOUT_MS=20000
AI_PLANNER_REASONING_EFFORT=low
AI_SYNTHESIS_REASONING_EFFORT=low
AI_PLANNER_MAX_TOKENS=2000
AI_SYNTHESIS_MAX_TOKENS=3000
AI_MAX_TOOL_CALLS=3
AI_MAX_PROVIDER_CALLS=4
AI_MAX_PARALLEL_TOOLS=3
AI_MAX_CONTEXT_MESSAGES=8
AI_MAX_TOOL_RESULT_BYTES=60000
AI_MAX_TOOL_ITEMS=8
AI_TOOL_TIMEOUT_MS=15000
AI_EVENT_TOOL_TIMEOUT_MS=150000
AI_MOBILITY_TOOL_TIMEOUT_MS=45000
AI_TOTAL_TIMEOUT_MS=240000
AI_CONFIRMATION_TTL_MINUTES=15
ACTIVITY_DISCOVERY_TTL_HOURS=24
RESTAURANT_DISCOVERY_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Email delivery (one provider, no fallback between them)
# ---------------------------------------------------------------------------
# Production: EMAIL_PROVIDER=resend with EMAIL_PROVIDER_API_KEY and an EMAIL_FROM on a
# verified sending domain. Leave EMAIL_PROVIDER empty to run with email disabled.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
# Only for EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=
EMAIL_TIMEOUT_MS=15000
INVOICE_AUTO_GENERATE=true

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_SCHEDULE_INTERVAL_MS=60000
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_JOB_TIMEOUT_MS=120000
WORKER_SHUTDOWN_GRACE_MS=20000
# Optional. Comma-separated trip UUIDs; empty plans jobs for every confirmed or active trip.
WORKER_TRIP_IDS=
