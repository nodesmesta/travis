NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# /ready fails when queued jobs are overdue by more than this many seconds (no worker is claiming them).
READY_JOB_STALE_SECONDS=300
# Optional. When set, GET /metrics requires "Authorization: Bearer <token>". The reverse proxy must not expose /metrics publicly.
METRICS_TOKEN=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Server-only integrations. Keep empty until the relevant task is implemented.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase Auth configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local development and browser test scripts only: also show the email and password form.
# Leave unset in production. Sign-in there is Google only (see deploy/README.md).
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=
# Google OAuth client for the self-hosted Supabase Auth server and the local CLI stack.
# Create it in Google Cloud (Google Auth Platform > Clients > Web application).
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=
BRIGHT_DATA_TIMEOUT_MS=60000
# Test hook only (rejected when NODE_ENV=production): replaces https://api.brightdata.com/request.
BRIGHT_DATA_ENDPOINT_OVERRIDE=
EVENT_DISCOVERY_TTL_HOURS=6
EVENT_MAX_PAGES=4
EVENT_PAGE_MAX_CHARS=15000
EVENT_PAGE_CONCURRENCY=3
AI_EXTRACTION_TIMEOUT_MS=45000

# Assistant orchestration (Task 09). Timeouts and reasoning levels were
# calibrated against live measurements (plan/segments/04-ai-orchestration.md).
AI_PLANNER_TIMEOUT_MS=15000
AI_SYNTHESIS_TIMEOUT_MS=20000
AI_PLANNER_REASONING_EFFORT=low
AI_SYNTHESIS_REASONING_EFFORT=low
AI_PLANNER_MAX_TOKENS=2000
AI_SYNTHESIS_MAX_TOKENS=3000
AI_MAX_TOOL_CALLS=3
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_MAX_PROVIDER_CALLS=4
AI_MAX_PARALLEL_TOOLS=3
AI_MAX_CONTEXT_MESSAGES=8
AI_MAX_TOOL_RESULT_BYTES=60000
AI_MAX_TOOL_ITEMS=8
AI_TOOL_TIMEOUT_MS=15000
AI_EVENT_TOOL_TIMEOUT_MS=150000
AI_MOBILITY_TOOL_TIMEOUT_MS=45000
AI_TOTAL_TIMEOUT_MS=240000
AI_CONFIRMATION_TTL_MINUTES=15
HERE_API_KEY=
HERE_TIMEOUT_MS=15000
OPENWEATHER_API_KEY=
OPENWEATHER_TIMEOUT_MS=15000
ACTIVITY_DISCOVERY_TTL_HOURS=24
RESTAURANT_DISCOVERY_TTL_HOURS=12

# Email delivery (Task 11). One provider per environment, no fallback between them.
#   EMAIL_PROVIDER=smtp     local: the Supabase Mailpit container (UI on port 55424).
#                           Its SMTP port 1025 is not published to the host, so SMTP_HOST is
#                           the container address: docker inspect supabase_inbucket_vultr
#   EMAIL_PROVIDER=resend   production: needs EMAIL_PROVIDER_API_KEY and a verified EMAIL_FROM domain.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=
EMAIL_TIMEOUT_MS=15000
# Queue a generate_invoice job when a payment succeeds (the worker runs it).
INVOICE_AUTO_GENERATE=true

# Local demo only. Generated into .env.local by `npm run bootstrap:local`.
# Never commit real values.
DEMO_EMAIL=demo@travelflow.local
DEMO_PASSWORD=

# Background worker (Task 10). `npm run start:worker:local` reads .env.local.
# The worker needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY, plus HERE_API_KEY and
# OPENWEATHER_API_KEY for the weather and traffic refresh jobs.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_SCHEDULE_INTERVAL_MS=60000
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_JOB_TIMEOUT_MS=120000
WORKER_SHUTDOWN_GRACE_MS=20000
# Optional. Comma separated trip ids; empty plans jobs for every confirmed or active trip.
WORKER_TRIP_IDS=
